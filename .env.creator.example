# Sao chép thành .env.creator trên MÁY CHỦ. Không commit tệp thật.
ENVIRONMENT=production
PUBLIC_API_URL=https://creator-api.ten-mien-cua-ban.vn
ALLOWED_ORIGINS=https://minhsybk-bit.github.io

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Chỉ cần cấu hình nhà cung cấp được bán cho khách hàng.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5.6-terra
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-3.1-flash-lite

REDIS_URL=redis://redis:6379/0
CREATOR_STORAGE_DIR=/data/creator

# Tạo bằng: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=524288000
MAX_VIDEO_SECONDS=1800
OUTPUT_RETENTION_HOURS=24
