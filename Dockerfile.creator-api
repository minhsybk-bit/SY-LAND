FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY creator-api-requirements.txt .
RUN python -m pip install --upgrade pip \
    && python -m pip install -r creator-api-requirements.txt

COPY creator_api ./creator_api

RUN useradd --create-home --uid 10001 syland \
    && mkdir -p /data/creator \
    && chown -R syland:syland /app /data/creator
USER syland

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "creator_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
